# Copy this file to `.env` and fill in your Supabase project values
# (supabase.com -> your project -> Project Settings -> API).
# `.env` is gitignored; this example file is safe to commit.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_...

# Google sign-in: the *Web* OAuth client ID from Google Cloud Console
# (Google Auth Platform -> Clients). Android uses it as the serverClientId so
# the returned ID token is addressed to the same client Supabase verifies
# against. Not a secret, but kept here so no key is hardcoded in Dart.
GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
